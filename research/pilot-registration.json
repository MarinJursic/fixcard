  "kill_criteria": [
    {
      "id": 1,
      "criterion": "More than 80% of relevant developers create no card after onboarding."
    },
    {
      "id": 2,
      "criterion": "Median creation remains above 30 seconds."
    },
    {
      "id": 3,
      "criterion": "Strong-match false positives exceed 20%."
    },
    {
      "id": 4,
      "criterion": "Most users prefer ordinary history, Atuin, Recall, or equivalent search."
    },
    {
      "id": 5,
      "criterion": "Fewer than 10% of cards are reused by another person over eight weeks in active teams."
    },
    {
      "id": 6,
      "criterion": "Teams refuse committed cards as clutter or liability."
    },
    {
      "id": 7,
      "criterion": "Secret redaction is not reliable enough for shared cards."
    },
    {
      "id": 8,
      "criterion": "Cards become stale faster than they are used."
    },
    {
      "id": 9,
      "criterion": "The product needs automatic terminal capture to feel valuable."
    },
    {
      "id": 10,
      "criterion": "Adoption depends on AI generation, cloud sync, or workflow replay."
